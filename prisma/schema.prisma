generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Asset {
  id         String   @id @default(uuid())
  symbol     String
  type       String   // "crypto" or "stock"
  pythFeedId String?
  network    String   @default("testnet")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([symbol, network])
}

model Market {
  id              String            @id @default(uuid())
  engineAddress   String            // EVM Engine Contract Address managing this market
  symbol          String            // e.g. "AAPL"
  strike          Float
  expiry          DateTime
  collateralToken String            // WETH or USDG contract address
  totalLiquidity  Float             @default(0)
  premiumAsk      Float             @default(0)
  type            String            @default("crypto") // "crypto" or "us_stocks"
  pythFeedId      String?           // Pyth Network Price Feed ID
  isSynthetic     Boolean           @default(false)
  network         String            @default("testnet") // "testnet" or "mainnet"
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  positions       OptionPosition[]
  trades          TradeHistory[]

  @@unique([symbol, strike, expiry, collateralToken, network])
}

model OptionPosition {
  id              String   @id @default(uuid())
  ownerAddress    String   // EVM wallet address
  marketId        String
  market          Market   @relation(fields: [marketId], references: [id])
  quantity        Float
  positionType    String   // "WRITTEN" or "BOUGHT"
  collateralToken String
  expiry          DateTime
  network         String   @default("testnet")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TradeHistory {
  id              String   @id @default(uuid())
  userAddress     String   // EVM wallet address
  marketId        String
  market          Market   @relation(fields: [marketId], references: [id])
  action          String   // "WRITE" or "BUY"
  quantity        Float
  price           Float
  collateralToken String
  expiry          DateTime
  txSignature     String   @unique // EVM transaction hash
  network         String   @default("testnet")
  createdAt       DateTime @default(now())
}

model SystemLog {
  id          String   @id @default(uuid())
  level       String
  message     String
  environment String   // "dev" or "prod"
  network     String   @default("testnet")
  metadata    Json?
  createdAt   DateTime @default(now())
}
